# Real credentials. example.json is committed and shows the shape.
env/*.json
!env/example.json

.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
*.iml

# Generated by build_runner (Riverpod). Regenerated on demand.
*.g.dart
*.freezed.dart

# Signing material must never be committed.
android/key.properties
android/app/*.jks
android/app/*.keystore
ios/Runner/GoogleService-Info.plist
